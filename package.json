{
  "name": "portfolio-backend-api",
  "version": "1.0.0",
  "description": "A comprehensive backend API for portfolio management with Node.js, Express, and PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "seed": "node src/scripts/seed.js",
    "seed:demo": "node src/scripts/seed.js -- --demo",
    "seed:dev": "node src/scripts/seed.js -- --users 5 --projects 10 --posts 15",
    "seed:undo": "npx sequelize-cli db:seed:undo:all",
    "db:setup": "npm run migrate && npm run seed",
    "db:reset": "npm run migrate:undo && npm run migrate && npm run seed",
    "docs:generate": "node src/scripts/generateDocs.js",
    "docs:serve": "npm start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:system": "node src/scripts/systemTest.js",
    "test:db": "node src/scripts/testDb.js",
    "seed:simple": "node src/scripts/simpleSeed.js"
  },
  "keywords": [
    "portfolio",
    "api",
    "nodejs",
    "express",
    "postgresql",
    "sequelize",
    "jwt",
    "rest-api"
  ],
  "author": "Portfolio API Developer",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "sequelize": "^6.35.2",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "sequelize-cli": "^6.6.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "@faker-js/faker": "^8.3.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}